<Layouts.flash_group flash={@flash} />
<div class="sg-room">
  <div class="sg-side">
    <section class="sg-card">
      <h2 class="sg-card__title">Signal Garden</h2>
      <p class="sg-form__value">
        The interactive control room lives at the root path.
      </p>
      <p class="sg-controls__hint">
        It renders the deterministic gossip simulator as a live network.
      </p>
      <a class="sg-btn sg-btn--solid" href={~p"/"}>Open the control room</a>
    </section>
  </div>
</div>
